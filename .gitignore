out/
dist/
dev-data/
docs/
*.db
*.db-shm
*.db-wal
*.tsbuildinfo
.env
.env.*

# Drive content — emulators, players, media, and game files never belong in the repo.
# These entries catch anything that accidentally lands in the project folder
# (e.g. MAME writing cfg/ relative to the working directory during dev).
cfg/
roms/
media/
emulators/
players/

# Mac ffmpeg binaries bundled into the DMG. Fetched by scripts/fetch-mac-ffmpeg.js
# before `electron-builder --mac` runs — kept out of git because of their size.
resources/mac-arm64/
resources/mac-x64/

# Generated build artifacts
build/icon.png
build/icon.ico
builder-debug.yml
builder-effective-config.yaml

# Cygwin crash dumps
*.stackdump

# Local-only scripts
scripts/fetch-bugle-call.ps1
